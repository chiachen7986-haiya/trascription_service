<Window x:Class="BlueJays.App.Views.AudioSourceDeviceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:BlueJays.App.Localization"
 Title="{loc:Tr ChooseDevice}" Width="650" Height="350" MinWidth="500" MinHeight="300" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{loc:Tr ChooseDevice}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SourceNameText" Margin="0,8,0,10" TextWrapping="Wrap"/>
   <TextBlock Text="{loc:Tr SelectAnActiveDeviceForThisSourceItsNameAnd}" TextWrapping="Wrap" Foreground="#65748B" FontSize="12"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="{loc:Tr Refresh}" Click="Refresh_Click" Margin="8,0,0,0"/><ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="{loc:Tr AudioDevice}"/></DockPanel><TextBlock x:Name="ErrorText" Foreground="#A44225" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Tr Cancel}" IsCancel="True"/><Button Content="{loc:Tr UseSelectedDevice}" Click="Use_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel>
 </Grid>
</Window>
