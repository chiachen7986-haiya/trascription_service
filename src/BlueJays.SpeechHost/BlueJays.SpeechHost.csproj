<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BlueJays.SpeechHost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BlueJays.Core/BlueJays.Core.csproj" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" ExcludeAssets="native" />
    <PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Version="1.24.1" />
    <Content Include="../../native/win-x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Exclude the CPU-only native runtime pulled transitively by sherpa's C# facade. -->
  <Target Name="UseBlueJaysSpeechRuntime" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('org.k2fsa.sherpa.onnx.runtime.'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('org.k2fsa.sherpa.onnx.runtime.'))" />
    </ItemGroup>
  </Target>
  <Target Name="ValidateSpeechNative" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../native/win-x64/sherpa-onnx-c-api.dll')" Text="The native speech runtime is missing. See native/README.md for the reproducible build instructions." />
  </Target>
</Project>
