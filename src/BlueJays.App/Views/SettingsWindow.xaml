<Window x:Class="BlueJays.App.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:BlueJays.App.Localization" xmlns:views="clr-namespace:BlueJays.App.Views"
 Title="Transcription Service · Settings" Width="740" Height="790" MinWidth="660" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="{loc:Tr MakeItYours}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr LocalSpeechRecognitionYourChoiceOfTranslationProvider}" Foreground="#65748B" Margin="0,5,0,0"/></StackPanel>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="White" BorderBrush="#D4DEEB">
   <TabItem Header="{loc:Tr General}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="{loc:Tr ApplicationLanguage}" FontSize="18" FontWeight="SemiBold"/>

    <ComboBox x:Name="UiLanguageBox" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,12,0,8"/>
    <TextBlock Text="{loc:Tr ChangesApplyWhenYouSaveSettingsTranscriptAndTranslationLanguages}" TextWrapping="Wrap" Foreground="#65748B" Margin="0,0,0,24"/>
    <CheckBox x:Name="MicNoiseBox" Margin="0,12,0,8"><TextBlock Text="{loc:Tr GTCRNMicrophoneNoiseSuppression}" TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="{loc:Tr AppliesToMicrophoneSourcesOnlyComputerAudioIsUnchanged}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11" Margin="0,0,0,24"/>
    <TextBlock Text="{loc:Tr ConversationDefaults}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="{loc:Tr DefaultSpokenLanguageForNewConversations}"/><ComboBox x:Name="SpeechLanguageBox" DisplayMemberPath="DisplayName" SelectedValuePath="Code" Margin="0,6,0,16"/>
    <TextBlock Text="{loc:Tr PreferredOutputLanguageForNewConversations}"/><ComboBox x:Name="TargetLanguageBox" DisplayMemberPath="DisplayName" SelectedValuePath="Name" Margin="0,6,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{loc:Tr SpeechRecognition}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
     <TextBlock Text="{loc:Tr SpeechEngine}" FontSize="18" FontWeight="SemiBold"/>
     <ComboBox x:Name="SpeechEngineBox" DisplayMemberPath="Name" SelectedValuePath="Engine" SelectionChanged="Engine_Changed" Margin="0,10,0,8"/>
     <TextBlock x:Name="EngineHelp" TextWrapping="Wrap" Foreground="#65748B" Margin="0,0,0,12"/>
     <StackPanel x:Name="OnnxOptions" Visibility="Collapsed">
      <TextBlock Text="{loc:Tr ComputeDevice}"/><ComboBox x:Name="SpeechDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Device" Margin="0,6,0,10"/>
      <TextBlock x:Name="ComputeHelp" TextWrapping="Wrap" FontSize="11" Foreground="#65748B" Margin="0,0,0,10"/>
      <CheckBox x:Name="CpuFallbackBox" Margin="0,0,0,10"><TextBlock Text="{loc:Tr UseCPUIfOpenVINOCannotStart}" TextWrapping="Wrap"/></CheckBox>
      <DockPanel Margin="0,0,0,10"><TextBlock Text="{loc:Tr CPUThreads}" VerticalAlignment="Center"/><ComboBox x:Name="CpuThreadsBox" Width="90" HorizontalAlignment="Right"/></DockPanel>
      <CheckBox x:Name="QwenPreviewsBox" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock Text="{loc:Tr QwenLivePreviewsSlower}" TextWrapping="Wrap"/></CheckBox>
     </StackPanel>
     <StackPanel x:Name="WhisperOptions">
     <TextBlock Text="{loc:Tr VulkanRunsSpeechRecognitionOnACompatibleGPUCPUFallback}" TextWrapping="Wrap" Foreground="#65748B" Margin="0,8,0,12"/>
     <CheckBox x:Name="GpuAccelerationBox" Margin="0,0,0,8"><TextBlock Text="{loc:Tr UseVulkanGPUAccelerationRecommended}" TextWrapping="Wrap"/></CheckBox>
     <CheckBox x:Name="ParallelDecodingBox" IsEnabled="{Binding IsChecked, ElementName=GpuAccelerationBox}" Margin="0,0,0,6"><TextBlock Text="{loc:Tr DecodeTwoLanguagesSimultaneously}" TextWrapping="Wrap"/></CheckBox>
     <TextBlock Text="{loc:Tr TwoConcurrentDecodesShareTheSameGPUAndMayBe}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11" Margin="0,0,0,18"/>
     <TextBlock Text="{loc:Tr AudioFromEachSourceStaysInOrderSeparateSourcesCan}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11" Margin="0,0,0,18"/>
     </StackPanel>
     <TextBlock x:Name="ModelPathLabel" Text="{loc:Tr ModelFile}" Margin="0,0,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="{loc:Tr Browse}" Click="Browse_Click" Margin="8,0,0,0"/><TextBox x:Name="ModelPathBox" AutomationProperties.Name="{loc:Tr ModelFile}"/></DockPanel>
     <WrapPanel x:Name="BundledWhisperButtons" Margin="0,8,0,0"><Button Content="{loc:Tr UseBundledBalancedModel}" Click="BalancedModel_Click"/><Button Content="{loc:Tr UseBundledAccuracyModel}" Click="AccuracyModel_Click"/></WrapPanel>
     <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" x:Name="DownloadButton" Content="{loc:Tr DownloadModel}" Click="Download_Click" Margin="8,0,0,0"/><ComboBox x:Name="ModelSizeBox" SelectedIndex="0"><ComboBoxItem Content="{loc:Tr BaseQuantizedBalanced57MB}" Tag="base-q5_1"/><ComboBoxItem Content="{loc:Tr SmallQuantizedAccuracy181MB}" Tag="small-q5_1"/><ComboBoxItem Content="{loc:Tr TinyFastest75MB}" Tag="tiny"/><ComboBoxItem Content="{loc:Tr BaseBalanced142MB}" Tag="base"/><ComboBoxItem Content="{loc:Tr SmallMoreAccurate466MB}" Tag="small"/></ComboBox></DockPanel>
     <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="1" Margin="0,10,0,4"/>
     <DockPanel><Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="{loc:Tr CancelDownload}" Click="CancelDownload_Click" Padding="8,3" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="DownloadStatus" Text="{loc:Tr DownloadSourceHuggingFaceGgerganovWhisperCpp}" FontSize="11" Foreground="#65748B" TextWrapping="Wrap"/></DockPanel>
     <StackPanel x:Name="WhisperAccuracyOptions"><CheckBox x:Name="NeuralDetectionBox" Margin="0,16,0,8"><TextBlock Text="{loc:Tr NeuralSpeechDetectionRejectSilenceAndBackgroundNoise}" TextWrapping="Wrap"/></CheckBox>
     <CheckBox x:Name="BeamSearchBox" Margin="0,0,0,12"><TextBlock Text="{loc:Tr BeamSearchMoreAccurateButSlower}" TextWrapping="Wrap"/></CheckBox></StackPanel>
     <TextBlock Text="{loc:Tr AddNamesAndJapaneseSpellingsToTheConversationGlossaryFor}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11" Margin="0,0,0,18"/>
     <DockPanel><TextBlock Text="{loc:Tr PauseBeforeFinalizingMilliseconds}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SilenceSlider, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/></DockPanel>
     <Slider x:Name="SilenceSlider" Minimum="700" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,8,0,18"/>
     <DockPanel><TextBlock Text="{loc:Tr MaximumPhraseLengthSeconds}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=PhraseSlider, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/></DockPanel>
     <Slider x:Name="PhraseSlider" Minimum="8" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,18"/>
     <DockPanel><TextBlock Text="{loc:Tr SpeechGateSensitivityRMSThreshold}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ThresholdSlider, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/></DockPanel>
     <Slider x:Name="ThresholdSlider" Minimum="0.002" Maximum="0.08" TickFrequency="0.002" Margin="0,8,0,4"/>
     <TextBlock Text="{loc:Tr LowerValuesDetectQuieterVoicesAnAdaptiveGateHandlesBackground}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Tr APIConfiguration}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
     <TextBlock Text="{loc:Tr TranslationProvider}" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Tr ConversationsWithOutputLanguagesSendTranscriptTextRecentConversationHistory}" TextWrapping="Wrap" Foreground="#65748B" Margin="0,8,0,18"/>
     <CheckBox x:Name="CorrectionBox" Margin="0,0,0,7"><TextBlock Text="{loc:Tr ContextAssistedTranscriptCorrection}" TextWrapping="Wrap"/></CheckBox>
     <TextBlock Text="{loc:Tr UsesThisProviderAndConversationContextToSuggestSmallSpelling}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11" Margin="0,0,0,12"/>
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,15"><Button Content="{loc:Tr DeepSeekPreset}" Click="DeepSeek_Click"/><Button Content="{loc:Tr GenericLocalPreset}" Click="Generic_Click"/></StackPanel>
      <TextBlock Text="{loc:Tr APIBaseURL}" Margin="0,0,0,5"/><TextBox x:Name="BaseUrlBox"/>
      <TextBlock Text="{loc:Tr ExampleHttpsApiDeepseekComV1DoNotAppendChat}" Foreground="#65748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,15"/>
      <TextBlock Text="{loc:Tr ModelID}" Margin="0,0,0,5"/><TextBox x:Name="ApiModelBox"/>
      <TextBlock Text="{loc:Tr APIKey}" Margin="0,15,0,5"/><PasswordBox x:Name="ApiKeyBox" Padding="9,7" BorderBrush="#CDD8E6"/>
      <TextBlock Text="{loc:Tr SavedWithWindowsDPAPIEncryptionForYourUserAccount}" Foreground="#65748B" FontSize="11" Margin="0,5,0,15"/>
      <CheckBox x:Name="ThinkingDisabledBox" Content="{loc:Tr SendDeepSeekSThinkingDisabledParameter}"/>
      <TextBlock Text="{loc:Tr DisableThisOptionForProvidersThatDoNotAcceptThe}" Foreground="#65748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock Text="{loc:Tr ForOfficialDeepSeekLiveTranslationAutomaticallySwitchesToNonThinking}" Foreground="#65748B" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{loc:Tr About}"><views:AboutView/></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A44225" Margin="0,12,0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Tr Cancel}" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="{loc:Tr SaveSettings}" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel>
 </Grid>
</Window>

