<UserControl x:Class="BlueJays.App.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Image Source="{StaticResource ServiceLogo}" Width="88" Height="88" HorizontalAlignment="Center" Margin="0,12,0,20"/>
  <TextBlock Grid.Row="1" Text="Transcription Service" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="2" Text="Version Rosedale (0.9)" HorizontalAlignment="Center" Foreground="#65748B" FontSize="16" Margin="0,10,0,24"/>
  <Border Grid.Row="3" Padding="18" Background="#FFF5DE" CornerRadius="8" Margin="0,0,0,28"><TextBlock Text="This software is strictly for internal use only, for direct profit distribution or resale is prohibited" TextWrapping="Wrap" TextAlignment="Center" Foreground="#75581D" FontSize="14"/></Border>
  <Image Grid.Row="4" Source="pack://application:,,,/TranscriptionService;component/Assets/About.png" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Center"/>
 </Grid></ScrollViewer>
</UserControl>
