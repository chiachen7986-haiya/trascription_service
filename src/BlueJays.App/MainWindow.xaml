<Window x:Class="BlueJays.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:BlueJays.App.Localization"
 Title="Transcription Service" Width="1180" Height="820" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#132C4E" Padding="28,18">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="White" CornerRadius="7" Padding="5" Margin="0,0,12,0"><Image Source="{StaticResource ServiceLogo}" Width="28" Height="28"/></Border><TextBlock Text="TRANSCRIPTION SERVICE" FontSize="21" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="{loc:Tr About}" Click="About_Click"/><Button Content="{loc:Tr PinnedCaptions}" Click="Float_Click"/><Button Content="{loc:Tr MeetingRoom}" Click="Room_Click"/><Button Content="{loc:Tr Settings}" Click="Settings_Click" IsEnabled="{Binding CanConfigure}" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="1" Margin="24,14,24,14">
   <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Left" Content="{loc:Tr NewConversation}" Style="{StaticResource PrimaryButton}" Click="NewConversation_Click" IsEnabled="{Binding CanConfigure}"/>
    <ComboBox Width="275" HorizontalAlignment="Left" DockPanel.Dock="Left" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="{loc:Tr Conversation}"/>
    <Button Content="{loc:Tr DeleteConversation}" Click="DeleteConversation_Click" IsEnabled="{Binding CanConfigure}" Padding="10,6" Margin="8,0,0,0"/><Button Content="{loc:Tr ClearAll}" Click="ClearConversations_Click" IsEnabled="{Binding CanConfigure}" Padding="10,6" Margin="8,0,0,0"/><TextBlock Text="{Binding LanguageSummary}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LanguageSummary}"/>
   </DockPanel>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Tr CancelExport}" Click="CancelExport_Click" Visibility="{Binding Exporting, Converter={StaticResource BoolVisibility}}"/><Button Content="{loc:Tr ExportCaptions}" Click="Export_Click" IsEnabled="{Binding CanExport}"/></StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="{loc:Tr StartResume}" Click="Start_Click" IsEnabled="{Binding CanStart}"/><Button Content="{loc:Tr StopFinish}" Click="Stop_Click" IsEnabled="{Binding CanStop}"/></StackPanel>
    <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </StackPanel>
  <Grid Grid.Row="2" Margin="24,0,24,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{loc:Tr AudioSources}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Expander x:Name="SourceAdder" Header="{loc:Tr AddSource}" IsExpanded="True" Margin="0,0,0,10"><StackPanel IsEnabled="{Binding CanConfigure}" Margin="0,10,0,0">
       <TextBlock Text="{loc:Tr ChooseWhatToCapture}" Foreground="#65748B" Margin="0,0,0,12"/>
       <ComboBox x:Name="SourceKindBox" SelectedIndex="0" SelectionChanged="SourceKind_Changed"><ComboBoxItem Content="{loc:Tr Microphone}"/><ComboBoxItem Content="{loc:Tr ComputerAudio}"/></ComboBox>
       <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" Margin="0,8,0,10" AutomationProperties.Name="{loc:Tr AudioDevice}"/>
       <StackPanel Orientation="Horizontal"><Button Content="{loc:Tr AddSource}" Click="AddSource_Click"/><Button Content="{loc:Tr Refresh}" Click="Refresh_Click" Margin="0"/></StackPanel>
      </StackPanel></Expander>
      <Border Height="1" Background="#E6ECF4" Margin="0,20,0,12"/>
     <TextBlock Text="{loc:Tr SourcesStaySeparateForCaptionLabels}" FontSize="12" Foreground="#65748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#E2E9F3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel>
       <TextBlock Text="{Binding KindLabel}" Foreground="#1767D7" FontSize="10" FontWeight="Bold"/>
       <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="205" FontSize="13"/></CheckBox>
       <TextBlock Text="{loc:Tr SourceName}" FontSize="11" Foreground="#65748B" Margin="0,4,0,3"/>
       <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" FontSize="12" Padding="6,4" LostFocus="SourceName_LostFocus" ToolTip="{loc:Tr RenameThisSourceBeforeStartingASession}" IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}"/>
       <TextBlock Text="{Binding DeviceName}" FontSize="10" Foreground="#65748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusColor}" TextWrapping="Wrap" Margin="0,5,0,0"/>
       <ProgressBar Value="{Binding Level}" Maximum="100" Height="5" BorderThickness="0" Foreground="#24A58B" Background="#E7EDF5" Margin="0,6,0,9"/>
       <WrapPanel IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=Window}}"><Button Content="{loc:Tr ChooseDevice}" Tag="{Binding}" Click="ChooseDevice_Click" Padding="8,3" FontSize="11"/><Button Content="{loc:Tr Remove}" Tag="{Binding}" Click="RemoveSource_Click" Padding="8,3" FontSize="11"/></WrapPanel>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="#E6ECF4" BorderThickness="0,0,0,1" Padding="22,17"><StackPanel><TextBlock Text="{Binding ConversationTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr DraftsUpdateInPlaceConversationsAreSavedAutomaticallyOnThis}" FontSize="12" Foreground="#65748B" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" MaxWidth="370" Margin="25"><TextBlock Text="{loc:Tr AClearerConversation}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{loc:Tr CreateANewConversationChooseItsLanguagesAddAnAudio}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#65748B" Margin="0,12,0,0"/></StackPanel>
     <ScrollViewer x:Name="CaptionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="CaptionScroll_Changed">
      <ItemsControl ItemsSource="{Binding Captions}" Margin="20,10"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="#F7F9FD" CornerRadius="9" Padding="16" Margin="0,6"><StackPanel>
        <DockPanel><TextBlock Text="{Binding Time}" FontSize="11" Foreground="#65748B" DockPanel.Dock="Right"/><TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" Foreground="#1767D7" TextWrapping="Wrap"/></DockPanel>
        <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Foreground="#45556D" FontSize="14" Margin="0,9,0,0"/>
        <Expander Header="{loc:Tr RawRecognitionBeforeContextCorrection}" Visibility="{Binding HasCorrection, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0" FontSize="11" Foreground="#65748B"><TextBlock Text="{Binding RawText}" TextWrapping="Wrap" Margin="0,5,0,0"/></Expander>
        <ItemsControl ItemsSource="{Binding Translations}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding DisplayLanguage}" FontSize="11" Foreground="#1767D7"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#65748B"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#65748B" Margin="0,8,0,0"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Padding="24,13"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#946119" FontSize="12" MinHeight="18"/></Border>
 </Grid>
</Window>

