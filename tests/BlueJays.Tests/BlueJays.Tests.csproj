<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/BlueJays.App/BlueJays.App.csproj" /></ItemGroup>
  <Target Name="CopySpeechHost" AfterTargets="Build">
    <ItemGroup><SpeechHostFiles Include="../../src/BlueJays.SpeechHost/bin/$(Configuration)/net10.0-windows/$(RuntimeIdentifier)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(SpeechHostFiles)" DestinationFiles="@(SpeechHostFiles->'$(OutDir)speech-host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
