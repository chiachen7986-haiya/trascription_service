<Window x:Class="BlueJays.App.Views.ConversationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:BlueJays.App.Localization"
 Title="{loc:Tr NewConversation}" Width="690" Height="760" MinWidth="520" MinHeight="540" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Tr NewConversation}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr ChooseTheLanguagesPeopleWillSpeakAndTheTranslationsTo}" TextWrapping="Wrap" Foreground="#65748B" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{loc:Tr ConversationName}"/><TextBox x:Name="NameBox" Margin="0,6,0,14" MaxLength="100"/>
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Tr Language}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{loc:Tr Spoken}"/><TextBlock Grid.Column="2" Text="{loc:Tr TranslateInto}"/></Grid>
   <ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding Spoken}" AutomationProperties.Name="{Binding SpokenAccessibility}"/><CheckBox Grid.Column="2" IsChecked="{Binding Target}" AutomationProperties.Name="{Binding TargetAccessibility}"/>
   </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{loc:Tr ChooseAtLeastOneSpokenLanguageAndUpToFour}" TextWrapping="Wrap" FontSize="12" Foreground="#65748B" Margin="0,12,0,16"/>
   <TextBlock Text="{loc:Tr MeetingTopicOptional}"/><TextBox x:Name="TopicBox" Margin="0,6,0,14" MaxLength="500"/>
   <TextBlock Text="{loc:Tr TerminologyDictionaryOptional}"/>
   <ComboBox x:Name="DictionaryBox" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Tr TerminologyDictionaryOptional}" Margin="0,6,0,8"/>
   <TextBlock Text="{loc:Tr ManageReusableDictionariesInSettings}" TextWrapping="Wrap" Foreground="#65748B" FontSize="11"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#A44225" TextWrapping="Wrap" Margin="0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Tr Cancel}" IsCancel="True"/><Button Content="{loc:Tr CreateConversation}" Click="Create_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></StackPanel>
 </Grid>
</Window>


