<Window x:Class="BlueJays.App.Views.RoomWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:BlueJays.App.Localization"
 Title="Transcription Service · Meeting room" Width="1200" Height="780" MinWidth="640" MinHeight="440" Background="#F7F8F5" Foreground="#171E23" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="18,10"><Button x:Name="FullScreenButton" DockPanel.Dock="Right" Content="{loc:Tr FullScreenF11}" Click="FullScreen_Click" Margin="0"/><StackPanel><TextBlock Text="{Binding ConversationTitle}" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr DragToTheRoomMonitorThenPressF11EscapeExits}" FontSize="11" Foreground="#64716E"/><TextBlock Text="{Binding RoomStatus}" FontSize="11" Foreground="#64716E"/><TextBlock Text="{Binding RoomCaption.Status}" Visibility="{Binding RoomCaption.HasCorrection, Converter={StaticResource BoolVisibility}}" FontSize="11" Foreground="#946119"/></StackPanel></DockPanel>
  <Viewbox Grid.Row="1" Stretch="Uniform"><Grid Width="1600" Height="920" Margin="25,10,25,25">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="{Binding RoomSource}" FontSize="29" FontWeight="SemiBold" Margin="16,0,16,8"/>
   <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="16,0,16,24"><TextBlock Text="{Binding RoomOriginal}" FontSize="37" TextWrapping="Wrap"/></ScrollViewer>
   <Grid Grid.Row="2"><TextBlock Text="{loc:Tr TranscriptionOnlyConversationNoTranslationLanguagesSelected}" FontSize="24" Foreground="#64716E" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoTargets, Converter={StaticResource BoolVisibility}}"/>
    <ItemsControl ItemsSource="{Binding DisplayTranslations}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding RoomColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Color}" BorderBrush="#6C7568" BorderThickness="2" Padding="32" Margin="12,0,12,20"><Grid x:Name="TranslationPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding DisplayLanguage}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Width="{Binding ActualWidth, ElementName=TranslationPanel}" Text="{Binding Text}" FontSize="39" TextWrapping="Wrap"/></Viewbox>
      <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="16" Foreground="#586047" Margin="0,16,0,0"/>
     </Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Grid></Viewbox>
 </Grid>
</Window>

